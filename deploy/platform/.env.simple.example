# ============================================
# AO.Space Platform - Simplified Configuration
# ============================================
# Copy this file to .env and modify the values
#
# SECURITY WARNING:
#   - Never commit .env to version control
#   - Use strong, unique passwords (see generation commands below)
#   - Set file permissions: chmod 600 .env

# --------------------------------------------
# Domain Configuration (REQUIRED)
# --------------------------------------------
# Your base domain (e.g., example.com)
# DNS records needed:
#   - A record: example.com -> YOUR_SERVER_IP
#   - A record: *.example.com -> YOUR_SERVER_IP
USER_DOMAIN=example.com

# --------------------------------------------
# Data Directory
# --------------------------------------------
DATA_DIR=./data

# --------------------------------------------
# MySQL Configuration
# --------------------------------------------
# Generate secure passwords:
#   openssl rand -base64 32 | tr -dc 'a-zA-Z0-9' | head -c 24
#
MYSQL_ROOT_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
MYSQL_DATABASE=aoplatform
MYSQL_USER=aoplatform
MYSQL_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# --------------------------------------------
# Redis Configuration
# --------------------------------------------
REDIS_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# --------------------------------------------
# Port Configuration (Optional)
# --------------------------------------------
# HTTP port (for redirect to HTTPS)
NGINX_BIND_HTTP=80

# HTTPS port (main service)
NGINX_BIND_HTTPS=443

# GT Server port (NAT traversal)
GT_BIND_PORT=61012

# --------------------------------------------
# Security Configuration (Optional)
# --------------------------------------------
# Rate limiting (requests per second per IP)
RATE_LIMIT_RPS=10

# Enable strict transport security (HSTS)
ENABLE_HSTS=true

# Allowed origins for CORS (comma-separated, empty = same origin only)
CORS_ORIGINS=
